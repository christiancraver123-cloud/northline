#!/bin/bash
# Northline.app — starts the Northline server in the background (via launchd) if needed, then opens it in its own window.
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"          # folder that contains Northline.app
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
NL="${NORTHLINE_HOME:-$APP_DIR/Northline Command Center (new)}"
[ -d "$NL" ] || NL="$HOME/Downloads/Northline Media/Northline Command Center (new)"
PORT=3100; URL="http://localhost:$PORT"; LABEL="media.northline.server"; LOG="$NL/.northline.log"
say() { osascript -e "display notification \"$1\" with title \"Northline\"" >/dev/null 2>&1; }
alert() { osascript -e "display alert \"Northline\" message \"$1\"" >/dev/null 2>&1; }
open_window() { if [ -d "/Applications/Google Chrome.app" ]; then open -na "Google Chrome" --args --app="$URL" --window-size=1400,900; else open "$URL"; fi; }
stop_server() { launchctl remove "$LABEL" 2>/dev/null; PIDS=$(lsof -ti tcp:$PORT -sTCP:LISTEN 2>/dev/null); [ -n "$PIDS" ] && kill $PIDS 2>/dev/null; sleep 2; PIDS=$(lsof -ti tcp:$PORT -sTCP:LISTEN 2>/dev/null); [ -n "$PIDS" ] && kill -9 $PIDS 2>/dev/null; }
healthy() { [ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$URL/login")" = "200" ]; }
echo "app: uname=$(uname -m) translated=$(sysctl -n sysctl.proc_translated 2>/dev/null) $(date)" > "$NL/.northline-app.txt" 2>/dev/null
[ -d "$NL" ] || { alert "Can't find the 'Northline Command Center (new)' folder. Keep Northline.app in the 'Northline Media' folder."; exit 1; }
if curl -s -o /dev/null --max-time 2 "$URL/manifest.webmanifest"; then
  if healthy; then open_window; exit 0; fi
  stop_server   # running but broken (e.g. an old Intel-mode server) → restart cleanly
fi
grep -q "darwin-x64" "$LOG" 2>/dev/null && rm -rf "$NL/.next"   # drop the build cache an Intel-mode run left behind
if [ ! -f "$NL/.phone-login" ]; then
  PW=$(osascript -e 'text returned of (display dialog "Choose a password for Northline (8+ characters)." default answer "" with hidden answer with title "Northline" buttons {"Cancel","Save"} default button "Save")' 2>/dev/null) || exit 0
  [ ${#PW} -lt 8 ] && { alert "That password is too short (8+ characters). Open Northline again."; exit 1; }
  { printf 'NORTHLINE_ADMIN_PASSWORD=%q\n' "$PW"; printf 'NORTHLINE_SESSION_SECRET=%s\n' "$(openssl rand -hex 32)"; } > "$NL/.phone-login"; chmod 600 "$NL/.phone-login"; unset PW
fi
chmod +x "$RES/server.sh" 2>/dev/null
: > "$LOG"
say "Starting… the first start takes a minute."
# Start as a detached child (launchd jobs can't read your Downloads folder). Force native arm64 on Apple Silicon.
if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ]; then
  nohup /usr/bin/arch -arm64 /bin/zsh -lc "exec '$RES/server.sh' '$NL' $PORT" >> "$LOG" 2>&1 < /dev/null &
else
  nohup /bin/zsh -lc "exec '$RES/server.sh' '$NL' $PORT" >> "$LOG" 2>&1 < /dev/null &
fi
disown
for i in $(seq 1 120); do curl -s -o /dev/null --max-time 2 "$URL/manifest.webmanifest" && break; sleep 2; done
if healthy; then echo "ok $(date)" > "$NL/.northline-health.txt"; open_window
else echo "unhealthy $(date)" > "$NL/.northline-health.txt"; open_window; alert "Northline started but a page failed to load. Details are in .northline.log in the app folder."; fi
