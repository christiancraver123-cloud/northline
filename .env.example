# Northline environment variables — NAMES ONLY. Copy to .env.local and fill in. Never commit real values.

# --- Operator authentication ---------------------------------------------------
# Required in production (the app is locked without them). Use a long random SESSION_SECRET.
NORTHLINE_ADMIN_PASSWORD=
NORTHLINE_SESSION_SECRET=
# Dev/local escape hatch only ("true" disables login). Never set in production.
NORTHLINE_AUTH_DISABLED=

# --- Persistence -------------------------------------------------------------
# "file" (default, local demo store in .data/) or "supabase"
NORTHLINE_STORE=file
# Supabase (server-side only). The service-role key must NEVER be exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Providers ---------------------------------------------------------------
# "mock" (default) or "openai"
IMAGE_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# "mock" (default) or "higgsfield"
VIDEO_PROVIDER=mock
HIGGSFIELD_API_KEY=

# --- Automation (n8n) --------------------------------------------------------
# Shared secret n8n must send as "Authorization: Bearer <secret>" to /api/n8n/*
NORTHLINE_WEBHOOK_SECRET=
N8N_BASE_URL=
N8N_API_KEY=

# --- Budgets (credits / USD; optional) ---------------------------------------
WEEKLY_GENERATION_BUDGET=

# --- LLM providers (server-side only; all optional — Northline runs without them) ---
# Google Gemini: background analysis, strategy, audits, reports, batch work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenAI text/LLM (stills use OPENAI_API_KEY + IMAGE_PROVIDER above).
OPENAI_TEXT_MODEL=gpt-4o-mini
# Optional operator-supplied pricing for cost tracking (USD per million tokens). Cost stays "unknown" without it.
# Example: {"gemini/gemini-2.5-flash":{"inputPerMTok":0,"outputPerMTok":0}}  <- fill in real values yourself
LLM_PRICING_JSON=
# Dev only: register the built-in mock LLM so routing can be exercised without keys.
LLM_ENABLE_MOCK=
# Worker concurrency (defaults: 4 total, 2 per provider)
AGENT_CONCURRENCY=
AGENT_LANE_CONCURRENCY=
